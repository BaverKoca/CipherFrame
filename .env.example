# Example environment variables for Cipher Frame.
APP_NAME=Cipher Frame
ENVIRONMENT=development
DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Example multi-origin list:
CORS_ORIGINS=http://localhost:8000,http://192.168.1.100:8000
DATABASE_PATH=storage/cipher_frame.db
LOG_LEVEL=INFO
# REQUIRED: Replace with a random secret key of at least 32 characters
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY_MIN_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_IMAGE_UPLOAD_BYTES=5242880
ALLOWED_IMAGE_TYPES=png,jpeg,gif,webp,bmp
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@cipherframe.local
# REQUIRED: Set a strong admin password
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
